// Osysharp.Llm — calling a model, done once: which model serves a call, what the call may spend, what it did spend.
//
//     app.Llm = new LlmSetup {
//       Models = [ new LlmModel { Name = "Fast", Client = new AnthropicClient { ApiKey = Secret.Anthropic }, Model = "claude-haiku-4-5" } ],
//     };
//
//     var answer  = Llm.Complete("Summarise this in a sentence: " + text);          // text in, text out
//     var invoice = Llm.Extract<Invoice>(scan);                                      // a typed value, read by its schema
//     var triage  = Llm.Decide<Urgency>(message);                                    // a typed decision, with a confidence
//
// Every call takes the same road, written here in Osy#: the operator's AI switch, the app's router, a reservation
// against every budget the call falls under, the provider, the next candidate when one fails, and a meter row for each
// attempt — priced from the app's price book, in micro-dollars, whether the attempt served, failed or was refused.
//
// ⚑ A PROVIDER IS AN INTERFACE (`ILlmClient`, `IDecisionModel`): Osysharp.Models.Anthropic, .OpenAi and .Gemini are
//   three, and any endpoint is a class you write. A ROUTER is one too (`ILlmRouter`): Osysharp.LlmRouter is one.
//
// ⚑ THE APP SAYS THREE THINGS, each with a default: who may call a model (`UsesModels`, everyone), who reads the meter
//   (`ReadsModelUsage`, nobody) and who sets prices and budgets (`ManagesModelSpend`, nobody). An app of many
//   organisations answers the meter a call at a time instead, by what each is charged to (`ReadsModelUsageOf`).
//
// It asks for nothing: no host, no secret. The provider kits ask for theirs.
package Osysharp.Llm {
  version     "2.4.1";
  minPlatform "0.15.0";
  summary     "calling a model: the provider and router contracts, the call path (route, reserve, call, fall back, meter), a price book and budgets with hard limits, typed extraction and typed decisions, and a scripted model for tests.";

  model "model/*.osy";
  tests "tests";
  // The personal data its own fields hold (`[Classification(Personal.X)]`): who a call was made for.
  personal Identity;
}
