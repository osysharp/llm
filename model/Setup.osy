// What the app says: which models it has, how calls are routed among them, and who may do what.
namespace Osysharp.Llm;

/// Who may call a model at all. Everyone, until the app says otherwise: `policy UsesModels => IsStaff;`.
virtual policy UsesModels => true;

/// Who reads the meter — every call's model, tokens and cost. Nobody, until the app says:
/// `policy ReadsModelUsage => IsFinance;`.
virtual policy ReadsModelUsage => false;

/// Who reads the calls charged to particular scopes — a call at a time, by what it is charged to (`ModelCall.Scopes`,
/// one scope a line). It is the answer for an app of many tenants, where `ReadsModelUsage` — one answer for the
/// whole app — would show one organisation what another's calls cost:
/// `policy ReadsModelUsageOf(string scopes) => Report.Any(r => scopes.Contains("report:" + r.Id.ToString()) && …);`.
/// Nobody, until the app says.
virtual policy ReadsModelUsageOf(string scopes) => false;

/// Who sets prices and budgets. Nobody, until the app says: `policy ManagesModelSpend => IsAdmin;`.
virtual policy ManagesModelSpend => false;

/// Who records on the meter a model call made somewhere else (`RecordOutsideModelCall`) — what a call cost is put on
/// the scopes they name. Whoever manages model spend, until the app says: `policy RecordsModelCalls => ManagesModelSpend
/// || IsBuildHost;`. The app's own code, with nobody signed in, records without it.
virtual policy RecordsModelCalls => ManagesModelSpend;

/// ⭐ WHICH OF THE APP'S MODEL KEYS A SIGNED-IN CALLER MAY SPEND (`LlmCall.Key`, `AgentRef.WithKey`), by the app's id
/// for the key. Everyone, until the app says: `policy UsesModelKey(string key) => ModelKey.Any(k => k.Id.ToString() == key
/// && MemberOf(k.Product));`. App code with nobody signed in chooses any key the app holds.
virtual policy UsesModelKey(string key) => true;

/// What a million tokens cost on one model, in US dollars. The meter multiplies these by the provider's own counts.
public class LlmPrice {
  /// A million tokens of prompt.
  public decimal Input = 0;
  /// A million tokens of answer.
  public decimal Output = 0;
  /// A million prompt tokens READ from the provider's cache — a fraction of `Input` on every provider that has one.
  /// Null: the same as `Input`.
  public decimal? CacheRead;
  /// A million prompt tokens WRITTEN to the cache — a little more than `Input` on providers that charge for it.
  /// Null: the same as `Input`.
  public decimal? CacheWrite;
}

/// One model the app has credentials for.
///
///     new LlmModel { Name = "Fast", Client = new AnthropicClient { ApiKey = Secret.Anthropic }, Model = "claude-haiku-4-5",
///                    Price = new LlmPrice { Input = 1, Output = 5 } }
public class LlmModel {
  /// The app's own name for it — "Fast", "Strong". What a call asks for, what a router orders, what the meter records.
  public string Name = "";
  /// The provider's id for it — "claude-haiku-4-5". What the provider is sent.
  public string Model = "";
  /// Who serves text and tool calls with it. Null for a model that only decides.
  public ILlmClient? Client;
  /// Who serves typed decisions with it (`Llm.Decide<T>`). Null for a model that only chats — it can still be asked to
  /// decide, through `Client`.
  public IDecisionModel? Decider;
  /// What it costs, until the price book has a row for it (`SetModelPrice`). All zero: its calls are metered at no cost.
  public LlmPrice Price = new LlmPrice();
  /// The most tokens an answer may run to when the call does not say — what a reservation assumes.
  public int MaxOutputTokens = 4096;
  /// How many calls may be on their way to this model at once. 0: no cap. A call past the cap moves to the next
  /// candidate, or is refused when there is none.
  public int MaxConcurrent = 0;

  // What a record of a call is written from. A setting is confined like a secret — its fields are not copied out — so
  // the three facts a meter row needs are answered here, by the model itself.
  public string NameOf() { return Name; }
  public string ProviderModel() { return Model; }
  public LlmPricePoint DeclaredPrice() {
    return new LlmPricePoint { Input = Price.Input, Output = Price.Output,
                               CacheRead = Price.CacheRead ?? Price.Input, CacheWrite = Price.CacheWrite ?? Price.Input };
  }
  public bool Chats() { return Client != null; }
  public bool Decides() { return Decider != null; }
}

/// ⭐ ONE KEY THE APP HOLDS FOR A PROVIDER, by the app's own id for it — never the key itself: the client holds that.
///
///     new LlmKey { Id = "team-a", Client = new AnthropicClient { ApiKey = Secret.TeamAKey } }
///
/// A call names a key (`LlmCall.Key`) and is then served by this key's client alone: every model the router orders for
/// it is sent through `Client` (or `Decider`), and the call never moves to another key or to a model's own client. The
/// meter records the key's id on every row (`ModelCall.Account`) and charges the call to `key:<Id>`, so a budget on
/// the key (`SetBudget("key", id, …)`) holds the calls made here and those recorded from elsewhere on it.
public class LlmKey {
  /// The app's id for the key — what a call names, what the meter records, the subject of the `key:` scope. Plain
  /// text, at most 200 characters, never anything built from a secret.
  public string Id = "";
  /// Who serves text and tool calls on this key — the same client classes a model names, built on this key's secret.
  public ILlmClient? Client;
  /// Who serves typed decisions on it. Null: a decision is asked through `Client`.
  public IDecisionModel? Decider;
  /// The app's models this key may serve, by their names. Empty: all of them.
  public List<string> Models = [];
  /// How many calls may be on their way on this key at once. 0: no cap.
  public int MaxConcurrent = 0;

  // A setting is confined like a secret — its fields are not copied out — so what a record needs is answered here.
  public string IdOf() { return Id; }
  public bool Chats() { return Client != null; }
  public bool Decides() { return Decider != null; }
  public bool Serves(string model) { return Models.Count == 0 || Models.Contains(model); }
  public int Cap() { return MaxConcurrent; }
}

/// What a call does when a budget it falls under has no room for it.
public enum LlmOnLimit {
  /// Refuse the call (`LlmBudgetExceeded`). The default.
  Stop,
  /// Try a cheaper model the router admits for what is left; refuse when there is none.
  StepDown,
}

/// How this app calls models — `app.Llm = new LlmSetup { … };`.
[AppSetting("Llm")]
public class LlmSetup {
  /// Every model the app may serve with. A call can never reach one that is not here.
  public List<LlmModel> Models = [];
  /// The model a call gets when it asks for none and there is no router — by `Name`. Empty: the first in `Models`.
  public string Default = "";
  /// Which model serves which call, and in what order the others are tried when it fails. Null: every call goes to the
  /// model it asked for, or to `Default`, and nothing is tried after it.
  public ILlmRouter? Router;
  /// How long a reservation holds a budget's room for a call that never reported back (a process that died mid-call).
  public TimeSpan HoldFor = TimeSpan.FromMinutes(10);
  /// The keys the app holds, each by its own id (`LlmKey`). A call names one with `LlmCall.Key`.
  public List<LlmKey> Keys = [];
  /// The key a call that names none runs on, by its id. "": such a call is served by the model's own `Client`.
  public string DefaultKey = "";
  /// ⭐ WHICH PROVIDER MODELS A CALL MAY BE SENT TO — an organisation's lock (ORGPOL OP-FP2). Entries are separated by
  /// commas or white space; each is a provider's id for a model (`claude-haiku-4-5`, what `LlmModel.Model` says) or a
  /// prefix ending in `*` (`claude-haiku-*`). Compared exactly, case and all. Empty: any model. A candidate outside it
  /// is never sent — whatever the app's router ordered — and a call with no candidate inside it is refused
  /// (`PolicyRefused`, key `Osysharp.Llm.LlmSetup.AllowedModels`).
  [OrgPolicy(OrgPolicyMode.Lock, Name = "Models a call may be sent to")] public string AllowedModels = "";
  /// ⭐ THE MOST TOKENS THE APP'S CALLS MAY USE IN ONE CALENDAR MONTH (UTC) — an organisation's range (ORGPOL OP-FP2):
  /// prompt, answer and cache tokens as the provider reports them, counted in `LlmOrgUsage`. A call that could take
  /// the month past it is refused before anything is sent (`PolicyRefused`, key `Osysharp.Llm.LlmSetup.MonthlyTokens`).
  /// Always the ceiling — never "0 means none" — so an app's own value is held inside the organisation's range; the
  /// default is as good as none.
  [OrgPolicy(OrgPolicyMode.Range, Name = "Monthly model tokens")] public long MonthlyTokens = 9000000000000000000;
  /// ⭐ A MODEL REQUEST WITH TOOLS ONLY FROM THE AGENTS KIT — an organisation's lock (ORGPOL OP-FP3b-2). When it is on, a
  /// call whose `LlmRequest.Tools` is not empty is refused (`PolicyRefused`, key
  /// `Osysharp.Llm.LlmSetup.ToolsOnlyThroughAgents`) unless the code asking is `Osysharp.Agents`'s own — never the app's,
  /// another package's, or the app's code the agents kit called back into. So an app cannot run its own tool loop through
  /// this kit: it gives the work to an agent (`Agents.Of<T>().Do(skill, input)`). A call without tools is never affected.
  /// Not refused: a typed answer (`Llm.Extract`, `Llm.Decide`, `OutputSchemaJson`) or text the app acts on, and a direct
  /// call to the provider's host unless the organisation leaves that host to its provider kit. Off, until the
  /// organisation locks it on.
  [OrgPolicy(OrgPolicyMode.Lock, Name = "Model tools only through agents")] public bool ToolsOnlyThroughAgents = false;
}
