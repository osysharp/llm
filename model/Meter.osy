// The meter — one row for every attempt to call a model: which model, why that one, what it used, what it cost —
// and the price book the cost is worked out from.
namespace Osysharp.Llm;

/// How a call reached the model.
public enum ModelCallKind {
  Complete,
  Stream,
  Decide,
  /// Made somewhere else — a host's session, another system on its own key — and recorded here, as it was measured
  /// there (`RecordOutsideModelCall`). Nothing of this app routed, held or sent it.
  Outside,
}

/// How one attempt ended.
public enum ModelCallOutcome {
  /// The provider answered, and this is what it used.
  Served,
  /// The provider failed or refused; the call moved to the next candidate, or failed with this one.
  Failed,
  /// A budget had no room for it, or it could cost more than the call may spend. Nothing was sent.
  OverBudget,
  /// The model was already serving as many calls as it allows. Nothing was sent.
  Busy,
}

/// ⭐ ONE ATTEMPT TO CALL A MODEL. A call that fell back twice is three rows, sharing `Call`.
///
/// A row is written once, when the attempt is over, and never changed — except that who it was for can be taken
/// off it (`ForgetModelCallRequester`). It is written only by this package's own call path, and for a call made
/// somewhere else by `RecordOutsideModelCall`: the app, a page, an import and another package can read what the app's
/// policy lets them read, and can write nothing.
public entity ModelCall {
  /// The call this attempt belongs to — every attempt of one `Llm.Complete` shares it.
  [Required, Immutable, Index] Guid Call;
  /// Which try it was: 0 for the router's first candidate.
  [Immutable] int Attempt = 0;
  [Immutable] DateTime At = DateTime.UtcNow;
  [Immutable] ModelCallKind Kind = ModelCallKind.Complete;
  [Immutable] ModelCallOutcome Outcome = ModelCallOutcome.Served;
  /// The app's name for the model, and the provider's id for it.
  [Required, Immutable, MaxLength(200), Index] string Model;
  [Immutable, MaxLength(200)] string ProviderModel = "";
  /// The model that failed before this one was tried. Null when none had.
  [Immutable, MaxLength(200)] string? FallbackFrom;

  /// Why this model: the rule of the app's router that ordered the candidates, the facts it decided from, and each
  /// model it dropped with the reason. The facts are kept whole so a decision can be replayed against another policy.
  [Immutable, MaxLength(200)] string RouteRule = "";
  [Immutable] Json? Facts;
  [Immutable] Json? Rejected;

  /// Who asked — the signed-in person the call ran for. Null for the system, and once they were taken off the meter.
  [Index, Classification(Personal.Identity)] Guid? Requester;
  /// What the call is charged to — `app:`, `requester:<id>`, `model:<name>` and the scopes its caller named, one per line.
  [MaxLength(2000)] string Scopes = "";
  /// What the call was for, in the caller's words. Never the prompt.
  [Immutable, MaxLength(200)] string Purpose = "";
  /// ⭐ THE KEY IT RAN ON, by the app's id for it — never the key itself: the app's own call on a key (`LlmCall.Key`),
  /// or the key or account a call made elsewhere ran on (`OutsideModelCall.Account`). A call with one is also charged to
  /// `key:<Account>`, so one budget holds a key's calls from here and from elsewhere. "": a model's own client.
  [Immutable, MaxLength(200), Index] string Account = "";

  /// The provider's own counts.
  [Immutable] int InputTokens = 0;
  [Immutable] int OutputTokens = 0;
  [Immutable] int CacheReadTokens = 0;
  [Immutable] int CacheWriteTokens = 0;
  /// What it cost, in millionths of a US dollar, at the price in force when it was made.
  [Immutable] long CostMicros = 0;
  /// The price-book row it was priced from. Null: the price on the model's own declaration.
  [Immutable] ModelPrice? Price;
  /// What was held against the budgets before the provider was called.
  [Immutable] long ReservedMicros = 0;
  [Immutable] int DurationMs = 0;
  /// What the provider said when it failed, or which budget refused — or, for a call made somewhere else, which budgets
  /// it took past their limit when it was counted.
  [Immutable, MaxLength(2000)] string? Problem;

  security {
    // Whoever manages spend reads the rows too: they are who deletes old ones and takes a person off them, and a row
    // nobody may read is a row nobody can find.
    allow read when ReadsModelUsage || ManagesModelSpend;
    // SECURITY-INVARIANT(llm-a-call-is-read-by-what-it-is-charged-to): a reader the app admits by `ReadsModelUsageOf`
    // reads a call only when the app's answer for THAT call's own scopes says so — never every call. Failure mode: one
    // tenant reads what another's calls were for and cost. Guarded by tests/calls.test.osy
    // `a_call_is_read_by_whoever_reads_what_it_is_charged_to_and_nobody_else`.
    allow read when IsAuthenticated where ReadsModelUsageOf(Scopes);
    allow create when UsesModels;
    deny create except via RecordModelCall;
    // SECURITY-INVARIANT(a-meter-row-changes-only-by-losing-who-it-was-for): every other member is immutable, and
    // these two are written only by `ForgetModelCallRequester`, which takes a person OFF a row and can put nobody on
    // one. A grant or an `except via` widened here lets what a call cost be moved to somebody else's name. Guarded by
    // tests/forget.test.osy `only_whoever_manages_spend_takes_a_person_off_the_meter_and_only_through_the_kit`.
    allow update when ManagesModelSpend;
    deny update Requester, Scopes except via ForgetModelCallRequester;
    allow delete when ManagesModelSpend;
    deny delete except via ForgetModelCallsBefore;
  }
}

/// ⭐ THE PRICE BOOK: what a million tokens cost on one model, from a moment on. A new price is a new row — a call is
/// priced by the row in force when it was made and keeps pointing at it, so a re-price never rewrites what was spent.
public entity ModelPrice {
  /// The app's name for the model.
  [Required, Immutable, MaxLength(200), Index] string Model;
  [Immutable] DateTime From = DateTime.UtcNow;
  /// US dollars per million tokens.
  [Immutable, Min(0)] decimal Input = 0;
  [Immutable, Min(0)] decimal Output = 0;
  [Immutable, Min(0)] decimal CacheRead = 0;
  [Immutable, Min(0)] decimal CacheWrite = 0;

  security {
    allow read when UsesModels || ReadsModelUsage || ManagesModelSpend;
    allow create when ManagesModelSpend;
    deny create except via SetModelPrice;
  }
}

/// From `from` on (now, when null), a million tokens on `model` cost this many US dollars. Cached reads and writes
/// cost what `input` does unless said. Earlier calls keep the price they were made at.
[Server, Authorize(ManagesModelSpend)]
public void SetModelPrice(string model, decimal input, decimal output, decimal? cacheRead = null, decimal? cacheWrite = null,
                          DateTime? from = null) {
  if (model.Trim() == "") { throw new ValidationException("Name the model the price is for — the app's own name for it."); }
  new ModelPrice {
    Model = model, From = from ?? DateTime.UtcNow, Input = input, Output = output,
    CacheRead = cacheRead ?? input, CacheWrite = cacheWrite ?? input,
  };
}

/// Everything a meter row says about an attempt before its outcome is known.
public class ModelCallOpening {
  public Guid Call;
  public int Attempt = 0;
  public ModelCallKind Kind = ModelCallKind.Complete;
  public string Model = "";
  public string ProviderModel = "";
  public string? FallbackFrom;
  public string RouteRule = "";
  public string FactsJson = "";
  public string RejectedJson = "";
  public Guid? Requester;
  public string Scopes = "";
  public string Purpose = "";
  public Guid? PriceRow;
  public long ReservedMicros = 0;
  /// When it was made — null: now, as the attempt ends; and the account it ran on (`ModelCall.Account`).
  public DateTime? At;
  public string Account = "";
}

/// ⭐ WRITE ONE METER ROW — in a unit of work of its own, so the row for an attempt that failed is still there after
/// the call it belonged to has failed, and a call made in the middle of other work commits none of that work.
[Server, Authorize(UsesModels), CommitsAlone]
internal void RecordModelCall(ModelCallOpening opening, ModelCallOutcome outcome, int inputTokens, int outputTokens,
                              int cacheReadTokens, int cacheWriteTokens, long costMicros, int durationMs, string? problem) {
  var price = opening.PriceRow == null ? null : ModelPrice.FirstOrDefault(p => p.Id == opening.PriceRow);
  new ModelCall {
    Call = opening.Call, Attempt = opening.Attempt, At = opening.At ?? DateTime.UtcNow, Kind = opening.Kind, Outcome = outcome,
    Model = opening.Model, ProviderModel = opening.ProviderModel, FallbackFrom = opening.FallbackFrom,
    RouteRule = opening.RouteRule, Facts = opening.FactsJson == "" ? null : opening.FactsJson,
    Rejected = opening.RejectedJson == "" ? null : opening.RejectedJson,
    Requester = opening.Requester, Scopes = opening.Scopes, Purpose = Clip(opening.Purpose, 200), Account = opening.Account,
    InputTokens = inputTokens, OutputTokens = outputTokens, CacheReadTokens = cacheReadTokens,
    CacheWriteTokens = cacheWriteTokens, CostMicros = costMicros, Price = price,
    ReservedMicros = opening.ReservedMicros, DurationMs = durationMs,
    Problem = problem == null ? null : Clip(problem!, 2000),
  };
}

/// A model call made somewhere else, as it was measured there — what `RecordOutsideModelCall` takes.
///
///     RecordOutsideModelCall(new OutsideModelCall {
///       Model = "claude-opus-5-5", InputTokens = 41200, OutputTokens = 3900, CacheReadTokens = 380000,
///       Cost = 1.42m, Account = "host-2 / Max B", At = startedAt, Purpose = "Build: nightly report",
///       Scopes = ["product:" + p.Id, "task:" + task.Id],
///     });
public class OutsideModelCall {
  /// The model, by the app's name for it when it has one, else the provider's id; and the provider's id ("": the same).
  public string Model = "";
  public string ProviderModel = "";
  /// The provider's own counts.
  public int InputTokens = 0;
  public int OutputTokens = 0;
  public int CacheReadTokens = 0;
  public int CacheWriteTokens = 0;
  /// What it cost, in US dollars, as measured where it ran. Null: priced here, from the price book in force `At`.
  public decimal? Cost;
  /// The key or account it ran on, by the app's id for it — never the key itself. The call is charged to `key:<Account>`
  /// with nothing named, as the app's own calls on that key are (`LlmCall.Key`).
  public string Account = "";
  /// When it was made. Null: now.
  public DateTime? At;
  /// What it was for, in the caller's words — never the prompt — and how long it took.
  public string Purpose = "";
  public int DurationMs = 0;
  /// What it is charged to besides the app and the model: each a `kind:subject` — `"product:" + p.Id`.
  public List<string> Scopes = [];
}

/// The kinds of scope the meter names itself on every call, and no caller may.
List<string> MeterScopeKinds() { return ["app:", "requester:", "model:", "key:"]; }

/// ⭐ RECORD A MODEL CALL MADE SOMEWHERE ELSE — a host's agent session, another system on a key of its own — on this
/// app's meter, as it was measured there: one `ModelCall` row (`Kind` = `Outside`) beside the app's own calls, so
/// `SpentOn(scope)`, every report that reads the meter and whoever reads by scope (`ReadsModelUsageOf`) see the spend
/// together. Answers the row's `Call`.
///
/// ⭐ IT COUNTS AGAINST THE BUDGETS, AFTER THE FACT. What it cost is counted against every budget an ordinary call
///   charged to the same scopes falls under — `app`, the recorder as `requester`, its `model`, and each scope named —
///   in the period it RAN in, by the same settle as the app's own calls (`SettleModelSpend`). Nothing is held for it
///   and it is never refused: it has already happened. When it takes a budget past its limit the row says so
///   (`Problem`), and the app's next call against that budget is refused like any over-spent one. `OutsideMicros` on
///   `LlmSpend`, and `SpentFromOutsideIn`, say how much of a budget's use came from outside. A call recorded with an
///   `Account` is charged to `key:<Account>` — the scope the app's own calls on that key (`LlmCall.Key`) are charged to —
///   so one budget on the key (`SetBudget("key", id, …)`) holds both, with nothing named.
///
/// ⚑ A RECORD, NOT A CALL. Nothing here routed or sent it, and it is not in the host's own count of the app's AI use.
///
/// Whoever `RecordsModelCalls` admits — whoever manages model spend, until the app says — and the app's own code.
// SECURITY-INVARIANT(llm-a-call-made-elsewhere-is-recorded-only-by-whom-the-app-names): a meter row for a call this
// app did not make is written only here, by whoever `RecordsModelCalls` admits (whoever manages model spend, until the
// app says) or the app's own code — never by whoever may merely call a model — with the meter's own scopes (`app:`,
// `requester:`, `model:`, `key:`) set here and refused from the caller, and `Kind` = `Outside` so it is never taken for a
// call the app made. Failure mode: anybody who uses models puts spend on another tenant's scope, or a forged row reads
// as the app's own routed call, or uses up another tenant's budget. Guarded by tests/calls.test.osy
// `a_call_made_somewhere_else_is_recorded_on_the_meter_as_it_was_measured_there`.
[Server, Authorize(RecordsModelCalls)]
public Guid RecordOutsideModelCall(OutsideModelCall call) {
  var model = call.Model.Trim();
  if (model == "") { throw new ValidationException("Name the model the call was made on."); }
  if (model.Length > 200 || call.ProviderModel.Length > 200) { throw new ValidationException("A model's name is at most 200 characters."); }
  if (call.InputTokens < 0 || call.OutputTokens < 0 || call.CacheReadTokens < 0 || call.CacheWriteTokens < 0 || call.DurationMs < 0) {
    throw new ValidationException("A call's counts are never below 0.");
  }
  if (call.Cost != null && call.Cost! < 0) { throw new ValidationException("A call costs 0 or more."); }
  if (call.Account.Length > 200) { throw new ValidationException("An account is named in at most 200 characters."); }
  var at = call.At ?? DateTime.UtcNow;
  if (at > DateTime.UtcNow.AddMinutes(5)) { throw new ValidationException("A call is recorded once it has been made: this one is in the future."); }
  List<string> scopes = ["app:"];
  var who = CurrentRequester();
  if (who != null) { scopes.Add("requester:" + who!.ToString()); }
  scopes.Add("model:" + model);
  var account = call.Account.Trim();
  if (account.Contains("\n")) { throw new ValidationException("An account is named on one line."); }
  if (account != "") { scopes.Add("key:" + account); }
  foreach (var named in call.Scopes) {
    var scope = ScopeLine(named);
    if (scope == "" || scope.Contains("\n") || scope.StartsWith(":")) { throw new ValidationException("A call is charged to a kind and a subject: `\"product:\" + p.Id`."); }
    foreach (var kind in MeterScopeKinds()) {
      if (scope.StartsWith(kind)) { throw new ValidationException($"`{kind}` is the meter's own: it names it on every call itself."); }
    }
    if (!scopes.Contains(scope)) { scopes.Add(scope); }
  }
  var lines = string.Join("\n", scopes);
  if (lines.Length > 2000) { throw new ValidationException($"A call is charged to at most 2000 characters of scopes, and these are {lines.Length}."); }
  var price = PriceAt(model, at);
  var cost = call.Cost == null
    ? CostMicros(price, call.InputTokens, call.OutputTokens, call.CacheReadTokens, call.CacheWriteTokens)
    : (long)Math.Ceiling(call.Cost! * 1000000m);
  var id = Guid.NewGuid();
  // Counted as the app's own calls are, by the one settle: nothing held, the period it ran in, never refused.
  var over = SettleModelSpend(id, cost, scopes, at);
  RecordModelCall(new ModelCallOpening {
    Call = id, Kind = ModelCallKind.Outside, Model = model, ProviderModel = call.ProviderModel.Trim() == "" ? model : call.ProviderModel.Trim(),
    Requester = who, Scopes = lines, Purpose = call.Purpose, PriceRow = call.Cost == null ? price.Row : null,
    At = at, Account = account,
  }, ModelCallOutcome.Served, call.InputTokens, call.OutputTokens, call.CacheReadTokens, call.CacheWriteTokens, cost, call.DurationMs,
    over == "" ? null : over);
  return id;
}

string Clip(string text, int max) { return text.Length <= max ? text : text.Substring(0, max); }

/// Delete the meter rows of calls made before `before`. Answers how many. What they cost stays counted against the
/// budgets they fell under.
[Server, Authorize(ManagesModelSpend)]
public int ForgetModelCallsBefore(DateTime before) {
  var old = ModelCall.Where(c => c.At < before).ToList();
  foreach (var row in old) { row.Delete(); }
  return old.Count;
}

/// What the calls charged to one scope cost in all, in US dollars — `SpentOn("task:" + task.Id)`, `SpentOn("app:")`.
/// Read from the meter, so it answers for scopes no budget covers; the reader needs `ReadsModelUsage`.
public decimal SpentOn(string scope) {
  var wanted = scope.IndexOf(":") < 0 ? scope + ":" : scope;
  decimal micros = 0;
  foreach (var c in ModelCall.Where(c => c.Outcome == ModelCallOutcome.Served && c.Scopes.Contains(wanted)).ToList()) {
    foreach (var line in c.Scopes.Split("\n")) { if (line == wanted) { micros = micros + c.CostMicros; } }
  }
  return micros / 1000000m;
}
